{
  "manifest_version": 3,
  "name": "lulucute",
  "version": "0.1.0",
  "description": "将论坛资源加入本地下载队列并查看归档进度。",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "nativeMessaging",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 lulucute"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
